# Backend API root (no trailing slash). Used for /auth/*, /chat/*, stickers under /api.
 #REACT_APP_API_BASE=http://localhost:5000/api

# Public URL of this React app (for referral links like /signup?ref=...). In dev, localhost is fine.
# For production, set to your deployed frontend origin, e.g. https://your-app.netlify.app
REACT_APP_SITE_URL=https://salesgrowbackend.onrender.com

Production examples (uncomment and adjust when deploying):
REACT_APP_API_BASE=https://salesgrowbackend.onrender.com
#  REACT_APP_API_BASE=http://localhost:5000/api
 REACT_APP_SITE_URL=https://salesgrowbackend.onrender.com
